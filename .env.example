# ---------------------------------------------------------------------------
# Supabase - projeto LaserHP
# Variaveis com prefixo NEXT_PUBLIC_ sao embutidas no bundle do navegador.
# Qualquer coisa SEM esse prefixo so existe no servidor (Server Components,
# Server Actions e Route Handlers) - e o lugar certo para segredos.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS - so em codigo de servidor.
# Pegue em: Supabase > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Valor aleatorio proprio, SEM prefixo NEXT_PUBLIC_. Tempera o hash do IP no
# limite de pedidos da vitrine, para que o hash nao possa ser revertido por
# forca bruta. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SALT_HASH_IP=troque-por-um-valor-aleatorio-longo

# URL publica do site (usada em metadados de SEO, sitemap e callback de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
