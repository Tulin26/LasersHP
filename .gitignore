# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# variaveis de ambiente e credenciais locais
.env*
.vercel

# estado local da CLI do Supabase (especifico desta maquina)
supabase/.temp

# o exemplo, sem segredo nenhum, fica versionado (precisa vir DEPOIS do .env*)
!.env.example

# senha do painel gerada localmente. Texto puro: leia, guarde no gerenciador
# de senhas e apague o arquivo. Nunca versionar.
senha-admin.txt
